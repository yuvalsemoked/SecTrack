        function updateGuard(guardId) {
            const name = document.getElementById('guardFullName').value;
            const idNumber = document.getElementById('guardId').value;
            const facility = document.getElementById('guardFacility').value;
            const weaponDate = document.getElementById('guardWeaponDate').value;
            
            if (!name || !idNumber) {
                alert('נא למלא שם מלא ותעודת זהות');
                return;
            }
            
            const guardIndex = guards.findIndex(g => g.id === guardId);
            if (guardIndex !== -1) {
                guards[guardIndex] = {
                    ...guards[guardIndex],
                    name: name,
                    idNumber: idNumber,
                    facility: facility,
                    weaponLicenseDate: weaponDate || null
                };
                
                refreshAllViews();
                document.getElementById('addGuardModal').classList.remove('active');
                showAlert('פרטי המאבטח עודכנו בהצלחה', 'success');
            }
            
            document.getElementById('saveGuardBtn').textContent = 'שמור מאבטח';
            document.getElementById('saveGuardBtn').onclick = function() {
                const name = document.getElementById('guardFullName').value;
                const idNumber = document.getElementById('guardId').value;
                const facility = document.getElementById('guardFacility').value;
                const weaponDate = document.getElementById('guardWeaponDate').value;
                
                if (!name || !idNumber) {
                    alert('נא למלא שם מלא ותעודת זהות');
                    return;
                }
                
                const existingGuard = guards.find(g => g.idNumber === idNumber);
                if (existingGuard) {
                    alert('קיים כבר מאבטח עם תעודת זהות זו');
                    return;
                }
                
                const newGuard = {
                    id: guards.length > 0 ? Math.max(...guards.map(g => g.id)) + 1 : 1,
                    name: name,
                    idNumber: idNumber,
                    facility: facility,
                    weaponLicenseDate: weaponDate || null
                };
                
                guards.push(newGuard);
                refreshAllViews();
                document.getElementById('addGuardModal').classList.remove('active');
                
                showAlert('מאבטח נוסף בהצלחה למערכת', 'success');
            };
        }
        
        window.deleteGuard = function(guardId) {
            if (confirm('האם אתה בטוח שברצונך למחוק מאבטח זה?')) {
                // מחיקת המאבטח מרשימת המאבטחים הפעילים בלבד
                guards = guards.filter(g => g.id !== guardId);
                
                // הסרת המאבטח מאימונים עתידיים בלבד (אלו שלא הסתיימו)
                trainings.forEach(training => {
                    if (!training.completed && training.guards) {
                        const index = training.guards.indexOf(guardId);
                        if (index !== -1) {
                            training.guards.splice(index, 1);
                            
                            if (guardsTrainingResults[training.id] && guardsTrainingResults[training.id][guardId]) {
                                delete guardsTrainingResults[training.id][guardId];
                            }
                        }
                    }
                });
                
                // שומרים את ההיסטוריה - לא מוחקים מאימונים שהסתיימו
                
                refreshAllViews();
                showAlert('המאבטח נמחק מרשימת המאבטחים הפעילים. נתוני היסטוריה נשמרו.', 'success');
            }
        };
        
