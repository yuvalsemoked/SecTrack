        // פונקציות לטבלת שיבוץ מאבטחים
        function refreshGuardAssignments() {
            const year = document.getElementById('guardAssignmentYear').value;
            const month = document.getElementById('guardAssignmentMonth').value;
            const type = document.getElementById('guardAssignmentType').value;
            
            const tbody = document.getElementById('guardAssignmentsTableBody');
            tbody.innerHTML = '';
            
            const yearSelect = document.getElementById('guardAssignmentYear');
            if (yearSelect.children.length === 0) {
                const currentYear = new Date().getFullYear();
                const nextYear = currentYear + 1;
                
                const years = [currentYear - 1, currentYear, nextYear];
                years.forEach(y => {
                    const option = document.createElement('option');
                    option.value = y;
                    option.textContent = y;
                    if (y === currentYear) option.selected = true;
                    yearSelect.appendChild(option);
                });
            }
            
            const needsTraining = (guard, trainingType, referenceDate) => {
                const today = new Date();
                const refDate = referenceDate ? new Date(referenceDate) : today;
                
                let lastTrainingDate = null;
                let lastTrainingResult = null;
                
                // בדיקה אם המאבטח כבר משובץ לאימון עתידי מסוג זה
                let alreadyAssigned = false;
                let assignedTrainingId = null;
                
                trainings.forEach(training => {
                    if (training.type === trainingType && training.guards && training.guards.includes(guard.id) && !training.completed) {
                        const trainingDate = new Date(training.date);
                        const trainingMonth = trainingDate.getMonth() + 1;
                        const trainingYear = trainingDate.getFullYear();
                        
                        if (trainingYear == year && (month === 'all' || trainingMonth == month)) {
                            alreadyAssigned = true;
                            assignedTrainingId = training.id;
                        }
                    }
                    
                    if (training.type === trainingType && training.guards && training.guards.includes(guard.id) && training.completed) {
                        const result = guardsTrainingResults[training.id]?.[guard.id];
                        if (result && result !== "not_attended" && result !== "pending") {
                            const trainingDate = new Date(training.date);
                            if (!lastTrainingDate || trainingDate > lastTrainingDate) {
                                lastTrainingDate = trainingDate;
                                lastTrainingResult = result;
                            }
                        }
                    }
                });
                
                if (alreadyAssigned) {
                    return { 
                        needed: false, 
                        lastDate: lastTrainingDate,
                        monthsSince: 0,
                        alreadyAssigned: true,
                        assignedTrainingId: assignedTrainingId
                    };
                }
                
                if (!lastTrainingDate) return { 
                    needed: true, 
                    lastDate: null,
                    monthsSince: 0,
                    alreadyAssigned: false,
                    assignedTrainingId: null
                };
                
                const monthsSinceLastTraining = (refDate.getFullYear() - lastTrainingDate.getFullYear()) * 12 + 
                                               (refDate.getMonth() - lastTrainingDate.getMonth());
                
                let requiredInterval = 12;
                
                switch(trainingType) {
                    case 'quarterly': requiredInterval = 3; break;
                    case 'refresh': requiredInterval = 6; break;
                }
                
                return { 
                    needed: monthsSinceLastTraining >= requiredInterval,
                    lastDate: lastTrainingDate,
                    monthsSince: monthsSinceLastTraining,
                    alreadyAssigned: false,
                    assignedTrainingId: null
                };
            };
            
            const needsWeaponRenewal = (guard, referenceDate) => {
                if (!guard.weaponLicenseDate) return { needed: false, lastDate: null };
                
                const licenseDate = new Date(guard.weaponLicenseDate);
                const refDate = new Date(referenceDate);
                
                let alreadyAssigned = false;
                let assignedTrainingId = null;
                
                trainings.forEach(training => {
                    if (training.type === "weapon" && training.guards && training.guards.includes(guard.id) && !training.completed) {
                        const trainingDate = new Date(training.date);
                        const trainingMonth = trainingDate.getMonth() + 1;
                        const trainingYear = trainingDate.getFullYear();
                        
                        if (trainingYear == year && (month === 'all' || trainingMonth == month)) {
                            alreadyAssigned = true;
                            assignedTrainingId = training.id;
                        }
                    }
                });
                
                if (alreadyAssigned) {
                    return { 
                        needed: false, 
                        lastDate: licenseDate,
                        monthsUntil: 0,
                        alreadyAssigned: true,
                        assignedTrainingId: assignedTrainingId
                    };
                }
                
                const monthsUntilExpiry = (licenseDate.getFullYear() - refDate.getFullYear()) * 12 + 
                                         (licenseDate.getMonth() - refDate.getMonth());
                
                return { 
                    needed: monthsUntilExpiry <= 3,
                    lastDate: licenseDate,
                    monthsUntil: monthsUntilExpiry,
                    alreadyAssigned: false,
                    assignedTrainingId: null
                };
            };
            
            const guardsNeedingTraining = [];
            const monthsNames = ['ינואר', 'פברואר', 'מרץ', 'אפריל', 'מאי', 'יוני', 
                               'יולי', 'אוגוסט', 'ספטמבר', 'אוקטובר', 'נובמבר', 'דצמבר'];
            
            guards.forEach(guard => {
                const trainingTypesToCheck = ['tactical', 'quarterly', 'attack', 'control', 'refresh'];
                
                trainingTypesToCheck.forEach(trainingType => {
                    if (type !== 'all' && type !== trainingType) return;
                    
                    const checkResult = needsTraining(guard, trainingType, `${year}-${month}-01`);
                    
                    if (checkResult.needed || checkResult.alreadyAssigned) {
                        let requiredMonth;
                        if (checkResult.lastDate && checkResult.needed) {
                            const lastDate = checkResult.lastDate;
                            let requiredDate = new Date(lastDate);
                            
                            switch(trainingType) {
                                case 'quarterly': requiredDate.setMonth(lastDate.getMonth() + 3); break;
                                case 'refresh': requiredDate.setMonth(lastDate.getMonth() + 6); break;
                                default: requiredDate.setFullYear(lastDate.getFullYear() + 1); break;
                            }
                            
                            requiredMonth = requiredDate.getMonth() + 1;
                        } else {
                            requiredMonth = month !== 'all' ? parseInt(month) : new Date().getMonth() + 1;
                        }
                        
                        if (month !== 'all' && requiredMonth != parseInt(month)) return;
                        
                        guardsNeedingTraining.push({
                            guard: guard,
                            trainingType: trainingType,
                            lastDate: checkResult.lastDate,
                            requiredMonth: requiredMonth,
                            alreadyAssigned: checkResult.alreadyAssigned,
                            assignedTrainingId: checkResult.assignedTrainingId
                        });
                    }
                });
                
                if (type === 'all' || type === 'weapon') {
                    const weaponCheck = needsWeaponRenewal(guard, `${year}-${month}-01`);
                    
                    if (weaponCheck.needed || weaponCheck.alreadyAssigned) {
                        let requiredMonth;
                        if (weaponCheck.lastDate && weaponCheck.needed) {
                            requiredMonth = new Date(guard.weaponLicenseDate).getMonth() + 1;
                        } else {
                            requiredMonth = month !== 'all' ? parseInt(month) : new Date().getMonth() + 1;
                        }
                        
                        if (month !== 'all' && requiredMonth != parseInt(month)) return;
                        
                        guardsNeedingTraining.push({
                            guard: guard,
                            trainingType: 'weapon',
                            lastDate: weaponCheck.lastDate,
                            requiredMonth: requiredMonth,
                            alreadyAssigned: weaponCheck.alreadyAssigned,
                            assignedTrainingId: weaponCheck.assignedTrainingId
                        });
                    }
                }
            });
            
            if (guardsNeedingTraining.length === 0) {
                tbody.innerHTML = `
                    <tr>
                        <td colspan="7" style="text-align: center; padding: 20px;">
                            <div class="alert alert-success">לא נמצאו מאבטחים הזקוקים לשיבוץ לאימון לפי הסינון שנבחר</div>
                        </td>
                    </tr>
                `;
                return;
            }
            
            guardsNeedingTraining.sort((a, b) => {
                if (a.guard.name === b.guard.name) {
                    return trainingTypes[a.trainingType].name.localeCompare(trainingTypes[b.trainingType].name);
                }
                return a.guard.name.localeCompare(b.guard.name);
            });
            
            guardsNeedingTraining.forEach(item => {
                const row = document.createElement('tr');
                const trainingTypeInfo = trainingTypes[item.trainingType] || { name: 'חידוש רישיון נשק', color: '#34495e', icon: 'fas fa-gun' };
                
                let buttonText = item.alreadyAssigned ? "שובץ לאימון" : "שייך לאימון";
                let buttonColor = item.alreadyAssigned ? "btn-warning" : "btn";
                let buttonAction = item.alreadyAssigned ? 
                    `removeFromTraining(${item.assignedTrainingId}, ${item.guard.id})` : 
                    `openAssignTrainingModal(${item.guard.id}, '${item.trainingType}', ${item.requiredMonth}, ${year})`;
                
                row.innerHTML = `
                    <td>${item.guard.name}</td>
                    <td>${item.guard.idNumber}</td>
                    <td>${item.guard.facility}</td>
                    <td>
                        <span style="color: ${trainingTypeInfo.color}; font-weight: 600;">
                            <i class="${trainingTypeInfo.icon}"></i> ${trainingTypeInfo.name}
                        </span>
                    </td>
                    <td>${item.lastDate ? formatDate(item.lastDate) : 'לא השתתף מעולם'}</td>
                    <td>
                        <span class="stats-badge" style="background-color: ${trainingTypeInfo.color};">${monthsNames[item.requiredMonth - 1]}</span>
                    </td>
                    <td>
                        <button class="btn ${buttonColor}" onclick="${buttonAction}" style="padding: 5px 10px; font-size: 12px;">
                            ${buttonText}
                        </button>
                    </td>
                `;
                tbody.appendChild(row);
            });
        }
        
        // פונקציה לפתיחת מודל בחירת אימון
        window.openAssignTrainingModal = function(guardId, trainingType, month, year) {
            // שמירת פרטי השיבוץ הממתין
            pendingAssignment = {
                guardId: guardId,
                trainingType: trainingType,
                month: month,
                year: year
            };
            
            // מציאת אימונים קיימים בחודש הנבחר
            const existingTrainings = trainings.filter(t => {
                const trainingDate = new Date(t.date);
                return t.type === trainingType && 
                       trainingDate.getFullYear() === year && 
                       trainingDate.getMonth() + 1 === month &&
                       !t.completed;
            });
            
            const container = document.getElementById('existingTrainingsList');
            container.innerHTML = '';
            
            if (existingTrainings.length > 0) {
                existingTrainings.forEach(training => {
                    const div = document.createElement('div');
                    div.className = 'training-selection-item';
                    div.innerHTML = `
                        <label>
                            <input type="radio" name="selectedTraining" value="${training.id}" style="margin-left: 10px;">
                            <strong>${formatDate(training.date)}</strong> - ${training.location}
                            <br>
                            <small>מדריך: ${training.instructor} | משובצים: ${training.guards.length}</small>
                        </label>
                    `;
                    container.appendChild(div);
                });
                
                const assignBtn = document.createElement('button');
                assignBtn.className = 'btn btn-success';
                assignBtn.style.marginTop = '15px';
                assignBtn.textContent = 'שייך לאימון שנבחר';
                assignBtn.onclick = function() {
                    const selectedRadio = document.querySelector('input[name="selectedTraining"]:checked');
                    if (selectedRadio) {
                        const trainingId = parseInt(selectedRadio.value);
                        assignToExistingTraining(trainingId, guardId);
                        document.getElementById('selectTrainingModal').classList.remove('active');
                        pendingAssignment = null;
                    } else {
                        alert('אנא בחר אימון');
                    }
                };
                container.appendChild(assignBtn);
            } else {
                container.innerHTML = '<div class="alert alert-warning">לא נמצאו אימונים מסוג זה בחודש הנבחר</div>';
            }
            
            document.getElementById('selectTrainingModal').classList.add('active');
        };
        
        // פונקציה לשיבוץ לאימון קיים
        window.assignToExistingTraining = function(trainingId, guardId) {
            const training = trainings.find(t => t.id === trainingId);
            if (training) {
                if (!training.guards.includes(guardId)) {
                    training.guards.push(guardId);
                    
                    if (!guardsTrainingResults[trainingId]) {
                        guardsTrainingResults[trainingId] = {};
                    }
                    guardsTrainingResults[trainingId][guardId] = "pending";
                    
                    refreshAllViews();
                    showAlert('המאבטח שובץ לאימון בהצלחה', 'success');
                } else {
                    showAlert('המאבטח כבר משובץ לאימון זה', 'warning');
                }
            }
        };
        
        // פונקציה ליצירת אימון חדש משיבוץ
        window.createNewTrainingFromAssignment = function(guardId, trainingType, month, year, location = '', instructor = '', description = '') {
            const trainingTypeName = trainingTypes[trainingType]?.name || 'חידוש רישיון נשק';
            
            const newTraining = {
                id: trainings.length > 0 ? Math.max(...trainings.map(t => t.id)) + 1 : 1,
                type: trainingType,
                date: `${year}-${month.toString().padStart(2, '0')}-15`,
                location: location || 'להגדיר',
                instructor: instructor || 'להגדיר',
                description: description || `${trainingTypeName} - שיבוץ אוטומטי`,
                guards: [guardId],
                completed: false
            };
            
            trainings.push(newTraining);
            
            guardsTrainingResults[newTraining.id] = {
                [guardId]: "pending"
            };
            
            refreshAllViews();
            showAlert('נוצר אימון חדש והמאבטח שובץ אליו בהצלחה', 'success');
        };
        
        // פונקציה להסרה משיבוץ
        window.removeFromTraining = function(trainingId, guardId) {
            const training = trainings.find(t => t.id === trainingId);
            if (!training) return;
            
            const index = training.guards.indexOf(guardId);
            if (index !== -1) {
                training.guards.splice(index, 1);
                
                if (guardsTrainingResults[trainingId] && guardsTrainingResults[trainingId][guardId]) {
                    delete guardsTrainingResults[trainingId][guardId];
                }
                
                // לא מוחקים אימון גם אם אין בו מאבטחים - שומרים אותו ריק
                
                refreshAllViews();
                
                const guard = guards.find(g => g.id === guardId);
                showAlert(`${guard.name} הוסר משיבוץ האימון`, 'success');
            }
        };
        
        // פונקציות פעולה
        window.updateTrainingResult = function(trainingId, guardId, result, event) {
            if (event) {
                event.stopPropagation();
            }
            
            if (!guardsTrainingResults[trainingId]) {
                guardsTrainingResults[trainingId] = {};
            }
            
            guardsTrainingResults[trainingId][guardId] = result;
            
            const selectElement = document.querySelector(`select[data-guard-id="${guardId}"][data-training-id="${trainingId}"]`);
            if (selectElement) {
                selectElement.className = `status-select ${getStatusClass(result)}`;
            }
            
            const training = trainings.find(t => t.id === trainingId);
            
            // עדכון תאריך חידוש רישיון נשק
            if (training && training.type === "weapon" && result === "passed" && training.completed) {
                const guardIndex = guards.findIndex(g => g.id === guardId);
                if (guardIndex !== -1) {
                    // עדכון התאריך לאותו תאריך של האימון
                    guards[guardIndex].weaponLicenseDate = training.date;
                    showAlert(`תאריך חידוש רישיון הנשק של ${guards[guardIndex].name} עודכן ל-${formatDate(training.date)}`, 'success');
                }
            }
            
            refreshAllViews();
            
            const guard = guards.find(g => g.id === guardId);
            const trainingType = trainingTypes[training.type].name;
            const resultText = getStatusText(result);
            
            showAlert(`עודכן סטטוס עבור ${guard.name} באימון ${trainingType}: ${resultText}`, 'success');
        };
        
        window.toggleTrainingCompletion = function(trainingId, completed) {
            const trainingIndex = trainings.findIndex(t => t.id === trainingId);
            if (trainingIndex !== -1) {
                trainings[trainingIndex].completed = completed;
                
                // בדיקה אם יש צורך לעדכן תאריכי רישיון נשק
                if (completed) {
                    const training = trainings[trainingIndex];
                    if (training.type === "weapon") {
                        training.guards.forEach(guardId => {
                            const result = guardsTrainingResults[trainingId]?.[guardId];
                            if (result === "passed") {
                                const guardIndex = guards.findIndex(g => g.id === guardId);
                                if (guardIndex !== -1) {
                                    guards[guardIndex].weaponLicenseDate = training.date;
                                }
                            }
                        });
                    }
                }
                
                refreshAllViews();
                
                const training = trainings[trainingIndex];
                const trainingType = trainingTypes[training.type].name;
                const statusText = completed ? "סומן כהסתיים" : "סומן כטרם הושלם";
                
                showAlert(`אימון ${trainingType} ${statusText}`, 'success');
            }
        };
        
