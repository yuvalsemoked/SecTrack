        function refreshLicenseRenewalAlerts() {
            const container = document.getElementById('licenseRenewalAlerts');
            container.innerHTML = '';
            
            const today = new Date();
            const nextMonth = new Date(today);
            nextMonth.setMonth(today.getMonth() + 1);
            
            const expiringSoon = [];
            const expired = [];
            
            guards.forEach(guard => {
                if (guard.weaponLicenseDate) {
                    const licenseDate = new Date(guard.weaponLicenseDate);
                    
                    if (licenseDate < today) {
                        expired.push({
                            name: guard.name,
                            date: guard.weaponLicenseDate,
                            daysOverdue: Math.floor((today - licenseDate) / (1000 * 60 * 60 * 24))
                        });
                    } else if (licenseDate <= nextMonth) {
                        const daysUntilExpiry = Math.floor((licenseDate - today) / (1000 * 60 * 60 * 24));
                        expiringSoon.push({
                            name: guard.name,
                            date: guard.weaponLicenseDate,
                            daysLeft: daysUntilExpiry
                        });
                    }
                }
            });
            
            if (expired.length > 0 || expiringSoon.length > 0) {
                let alertHtml = '<div class="license-renewal-alert">';
                
                if (expired.length > 0) {
                    alertHtml += '<h4><i class="fas fa-exclamation-circle"></i> רישיונות נשק שפג תוקפם:</h4>';
                    alertHtml += '<ul class="license-renewal-list">';
                    expired.forEach(guard => {
                        alertHtml += `<li class="license-renewal-item"><span>${guard.name}</span> <span style="color: #e74c3c;">פג תוקף לפני ${guard.daysOverdue} ימים (${formatDate(guard.date)})</span></li>`;
                    });
                    alertHtml += '</ul>';
                }
                
                if (expiringSoon.length > 0) {
                    if (expired.length > 0) alertHtml += '<hr style="margin: 15px 0;">';
                    alertHtml += '<h4><i class="fas fa-exclamation-triangle"></i> רישיונות נשק שפג תוקפם בחודש הקרוב:</h4>';
                    alertHtml += '<ul class="license-renewal-list">';
                    expiringSoon.forEach(guard => {
                        alertHtml += `<li class="license-renewal-item"><span>${guard.name}</span> <span style="color: #f39c12;">פג תוקף בעוד ${guard.daysLeft} ימים (${formatDate(guard.date)})</span></li>`;
                    });
                    alertHtml += '</ul>';
                }
                
                alertHtml += '</div>';
                container.innerHTML = alertHtml;
            }
        }
        
        function refreshTrainingsYearSelect() {
