        function refreshTrainingsGrid() {
            const trainingsGrid = document.getElementById('trainingsGrid');
            const selectedYear = document.getElementById('trainingsYearSelect').value;
            const selectedType = document.getElementById('trainingsTypeSelect').value;
            const activeFilter = document.querySelector('.filter-btn.active').dataset.filter;
            
            // שמירת מצב הסננים
            trainingFiltersState.year = selectedYear;
            trainingFiltersState.type = selectedType;
            trainingFiltersState.status = activeFilter;
            
            let filteredTrainings = [];
            if (selectedYear === 'all') {
                filteredTrainings = trainings;
            } else {
                filteredTrainings = trainings.filter(training => {
                    const year = new Date(training.date).getFullYear();
                    return year == selectedYear;
                });
            }
            
            if (selectedType !== 'all') {
                filteredTrainings = filteredTrainings.filter(t => t.type === selectedType);
            }
            
            if (activeFilter === 'completed') {
                filteredTrainings = filteredTrainings.filter(t => t.completed);
            } else if (activeFilter === 'incomplete') {
                filteredTrainings = filteredTrainings.filter(t => !t.completed);
            }
            
            if (filteredTrainings.length === 0) {
                trainingsGrid.innerHTML = '<div class="alert alert-success">לא נמצאו אימונים לפי הסינון שנבחר</div>';
                return;
            }
            
            trainingsGrid.innerHTML = '';
            
            filteredTrainings.sort((a, b) => new Date(b.date) - new Date(a.date));
            
            filteredTrainings.forEach(training => {
                const trainingType = trainingTypes[training.type];
                const trainingDate = new Date(training.date);
                
                let guardsHtml = '';
                if (training.guards && training.guards.length > 0) {
                    training.guards.forEach(guardId => {
                        const guard = guards.find(g => g.id === guardId);
                        if (guard) {
                            const status = guardsTrainingResults[training.id]?.[guardId] || "pending";
                            const statusText = getStatusText(status);
                            const statusClass = getStatusClass(status);
                            
                            guardsHtml += `
                                <div class="guard-item">
