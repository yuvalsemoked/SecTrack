            const guard = guards.find(g => g.id === guardId);
            if (guard) {
                document.getElementById('guardFullName').value = guard.name;
                document.getElementById('guardId').value = guard.idNumber;
                document.getElementById('guardFacility').value = guard.facility;
                document.getElementById('guardWeaponDate').value = guard.weaponLicenseDate || '';
                
