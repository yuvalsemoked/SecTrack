            trainings.forEach(training => {
                const year = new Date(training.date).getFullYear();
                yearsSet.add(year);
            });
            
            const years = Array.from(yearsSet).sort((a, b) => b - a);
            
            const allOption = document.createElement('option');
            allOption.value = 'all';
            allOption.textContent = 'כל השנים';
            yearSelect.appendChild(allOption);
            
            years.forEach(year => {
                const option = document.createElement('option');
                option.value = year;
                option.textContent = year;
                yearSelect.appendChild(option);
            });
            
            // שחזור מצב הסנן אם קיים
            if (trainingFiltersState.year) {
                yearSelect.value = trainingFiltersState.year;
            } else {
                const currentYear = new Date().getFullYear();
                if (years.includes(currentYear)) {
                    yearSelect.value = currentYear;
                    trainingFiltersState.year = currentYear;
                } else if (years.length > 0) {
                    yearSelect.value = years[0];
                    trainingFiltersState.year = years[0];
                } else {
                    yearSelect.value = 'all';
                    trainingFiltersState.year = 'all';
                }
            }
