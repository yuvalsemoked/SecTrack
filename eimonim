            showAlert('טבלת המאבטחים יוצאה בהצלחה', 'success');
        }
        
        function exportHistoryToExcel() {
            const selectedYear = document.getElementById('historyYearSelect').value;
            
            let filteredTrainings = trainings.filter(training => training.completed);
            
            if (selectedYear !== 'all') {
                filteredTrainings = filteredTrainings.filter(training => {
                    const year = new Date(training.date).getFullYear();
                    return year == selectedYear;
                });
            }
            
            filteredTrainings.sort((a, b) => new Date(b.date) - new Date(a.date));
            
            if (filteredTrainings.length === 0) {
                alert('אין נתונים לייצוא עבור השנה הנבחרת');
                return;
            }
            
            const exportData = [
                ['סוג אימון', 'תאריך', 'מיקום', 'מדריך', 'תיאור', 'מספר משתתפים', 'מאבטחים שהשתתפו', 'סטטוסים']
            ];
            
            filteredTrainings.forEach(training => {
                const trainingType = trainingTypes[training.type];
                
                let participatingGuards = [];
                let statusList = [];
                
                if (training.guards && guardsTrainingResults[training.id]) {
                    training.guards.forEach(guardId => {
                        const guard = guards.find(g => g.id === guardId);
                        const result = guardsTrainingResults[training.id][guardId];
                        if (guard && result && result !== "not_attended" && result !== "pending") {
                            participatingGuards.push(guard.name);
                            statusList.push(getStatusText(result));
                        }
                    });
                }
                
                exportData.push([
                    trainingType.name,
                    formatDate(training.date),
                    training.location,
                    training.instructor,
                    training.description,
                    participatingGuards.length,
                    participatingGuards.join(', '),
                    statusList.join(', ')
                ]);
            });
            
            const wb = XLSX.utils.book_new();
            const ws = XLSX.utils.aoa_to_sheet(exportData);
            
            if (!ws['!cols']) ws['!cols'] = [];
            for (let i = 0; i < exportData[0].length; i++) {
                ws['!cols'][i] = { width: i === 4 ? 40 : 20 };
            }
            
            const range = XLSX.utils.decode_range(ws['!ref']);
            for (let R = range.s.r; R <= range.e.r; ++R) {
                for (let C = range.s.c; C <= range.e.c; ++C) {
                    const cell_address = {c:C, r:R};
                    const cell_ref = XLSX.utils.encode_cell(cell_address);
                    
                    if (!ws[cell_ref]) continue;
                    
                    ws[cell_ref].s = {
                        alignment: {
                            horizontal: 'right',
                            vertical: 'center',
                            wrapText: true
                        },
                        font: {
                            name: 'Arial',
                            sz: 12
                        }
                    };
                }
            }
            
            const fileName = selectedYear === 'all' ? 'היסטוריית_אימונים_כל_השנים' : `היסטוריית_אימונים_${selectedYear}`;
            XLSX.utils.book_append_sheet(wb, ws, "היסטוריה");
            XLSX.writeFile(wb, `${fileName}_${new Date().toISOString().slice(0,10)}.xlsx`);
            
            showAlert(`היסטוריה יוצאה בהצלחה`, 'success');
        }
        
        // פונקציות שמירה וטעינת נתונים - LOCAL STORAGE
        function saveDataToStorage() {
            try {
                const data = {
                    guards: guards,
                    trainings: trainings,
                    guardsTrainingResults: guardsTrainingResults,
                    lastBackup: new Date().toISOString(),
                    trainingFilters: trainingFiltersState
                };
                
                localStorage.setItem(STORAGE_KEY, JSON.stringify(data));
                console.log('Data saved to localStorage at', new Date().toLocaleString());
                return true;
            } catch (error) {
                console.error('Error saving data to localStorage:', error);
                return false;
            }
        }
        
        function loadData(forceRestore = false) {
            const savedData = localStorage.getItem(STORAGE_KEY);
            
            if (savedData && !forceRestore) {
                try {
                    const parsedData = JSON.parse(savedData);
                    guards = parsedData.guards || [];
                    trainings = parsedData.trainings || [];
                    guardsTrainingResults = parsedData.guardsTrainingResults || {};
                    trainingFiltersState = parsedData.trainingFilters || { year: null, type: null, status: 'incomplete' };
                    
                    console.log('Data loaded from localStorage. Last backup:', parsedData.lastBackup);
                } catch (error) {
                    console.error('Error parsing local data:', error);
                    loadSampleData();
                }
            } else {
                loadSampleData();
            }
            
            initializeUI();
        }
        
        function loadSampleData() {
            guards = JSON.parse(JSON.stringify(sampleGuards));
            trainings = JSON.parse(JSON.stringify(sampleTrainings));
            guardsTrainingResults = JSON.parse(JSON.stringify(sampleTrainingResults));
            console.log('Loaded sample data');
        }
        
        function initializeUI() {
            refreshAllViews();
        }
        
        function checkConnection() {
            isOnline = navigator.onLine;
            
            if (!isOnline) {
                showAlert('מצב לא מקוון. נתונים ישמרו במכשיר זה בלבד.', 'warning');
            }
            
            window.addEventListener('online', () => {
                isOnline = true;
                showAlert('חיבור לאינטרנט שוחזר. נתונים יסונכרנו עם השרת.', 'success');
            });
            
            window.addEventListener('offline', () => {
                isOnline = false;
                showAlert('אין חיבור לאינטרנט. נתונים ישמרו במכשיר זה בלבד.', 'warning');
            });
        }
        
        function showAlert(message, type) {
            const existingAlerts = document.querySelectorAll('.alert:not(.license-renewal-alert *)');
            existingAlerts.forEach(alert => alert.remove());
            
            const alertDiv = document.createElement('div');
            alertDiv.className = `alert alert-${type}`;
            alertDiv.textContent = message;
            
            const main = document.querySelector('main');
            main.insertBefore(alertDiv, main.firstChild);
            
            setTimeout(() => {
                alertDiv.remove();
            }, 5000);
        }
        
        function formatDate(dateString) {
            const date = new Date(dateString);
            return date.toLocaleDateString('he-IL', {
                day: '2-digit',
                month: '2-digit',
                year: 'numeric'
            });
        }
        
        function getStatusText(status) {
            switch(status) {
                case "passed": return "עבר";
                case "failed": return "נכשל";
                case "attended": return "השתתף";
                case "not_attended": return "לא השתתף";
                default: return "ממתין";
            }
        }
        
        function getStatusClass(status) {
            switch(status) {
                case "passed": return "status-passed";
                case "failed": return "status-failed";
                case "attended": return "status-attended";
                case "not_attended": return "status-not-attended";
                default: return "status-pending";
            }
        }
        
        // שמירת נתונים לפני סגירת הדף
        window.addEventListener('beforeunload', function() {
            saveDataToStorage();
        });
    </script>
</body>
</html>
